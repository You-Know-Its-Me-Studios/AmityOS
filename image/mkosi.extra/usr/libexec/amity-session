#!/bin/sh
# Starts the AmityOS graphical session: the compositor, which starts the shell.
# Run by amity-session.service as the logged-in user on the first virtual terminal.
export XDG_CURRENT_DESKTOP=AmityOS
export XDG_SESSION_DESKTOP=AmityOS
export XDG_SESSION_TYPE=wayland
# The session bus of the user's service manager (dbus-user-session).
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi
# Firefox uses Wayland natively only when asked to.
export MOZ_ENABLE_WAYLAND=1
exec amity-comp
